# ============================================================
# ASTRAL Smart Agenda — variáveis de ambiente
# Copie para .env (ou cadastre no painel da hospedagem).
# NUNCA publique este arquivo preenchido.
# ============================================================

# Ambiente: use "production" no servidor (ativa HSTS e cookie seguro)
NODE_ENV=production

# Porta HTTP do servidor
PORT=3000

# Endereço público do sistema, com https (usado nos links das mensagens e no botão "Visualizar agenda")
APP_URL=https://agenda.seudominio.com.br

# Atrás de proxy reverso (Caddy, Nginx, Render, Railway…): 1 para confiar em X-Forwarded-For/Host/Proto
TRUST_PROXY=1

# Banco de dados e anexos — use um DISCO PERSISTENTE na hospedagem
DATABASE_PATH=./data/astral.db
ATTACHMENTS_DIR=./data/anexos

# Cópias de segurança automáticas (diárias, a partir das 03:00)
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# DISABLE_BACKUP=1

# Fuso padrão
APP_TIMEZONE=America/Cuiaba

# --- Contas criadas no primeiro start (troca de senha obrigatória no 1º login) ---
SUPERVISOR_NAME=Supervisor Técnico
SUPERVISOR_EMAIL=supervisor@astral.local
SUPERVISOR_INITIAL_PASSWORD=
COORDINATOR_NAME=Coordenador de Operações
COORDINATOR_EMAIL=coordenador@astral.local
COORDINATOR_INITIAL_PASSWORD=
# Se as senhas ficarem em branco, o sistema gera senhas fortes e grava em
# data/credenciais-iniciais.txt (apague o arquivo depois de usar).

# Agendador interno (verifica a fila a cada minuto, com o navegador fechado)
SCHEDULER_INTERVAL_MS=60000
# DISABLE_SCHEDULER=1   # só se usar um agendador externo chamando /api/cron/tick

# Segredo para agendador externo (opcional): POST /api/cron/tick com
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Segredo que assina os botões "Confirmar presença" (valor longo e aleatório, ex.: openssl rand -hex 32)
LINK_SIGNING_SECRET=

# ------------------------------------------------------------
# WhatsApp Business Platform — Cloud API oficial da Meta
# Sem estas variáveis o sistema funciona em MODO DEMONSTRAÇÃO
# (nenhuma mensagem é enviada e isso fica identificado em toda a tela).
# Passo a passo: docs/WHATSAPP.md
# ------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v23.0
