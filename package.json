{
  "name": "astral-smart-agenda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ASTRAL Smart Agenda — gestão operacional de auditorias, visitas técnicas, reuniões e notificações oficiais via WhatsApp",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "node --disable-warning=ExperimentalWarning dist/server.mjs --backup",
    "senha": "node --disable-warning=ExperimentalWarning dist/server.mjs --redefinir-senha",
    "db:reset-demo": "node --disable-warning=ExperimentalWarning dist/server.mjs --reset-demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "playwright": "1.56.0",
    "sharp": "0.35.4"
  }
}
